{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tincan discovery 0.1",
  "type": "object",
  "required": [
    "protocol",
    "versions",
    "profiles",
    "capabilities",
    "tools"
  ],
  "properties": {
    "protocol": {
      "const": "tincan"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
