{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tincan independent-room E2EE MLS profile 0.1",
  "description": "Structural validation only. Verify decoded lengths, signatures, MLS state, scope and semantic rules separately. Unknown signed fields require a new profile, not silent reinterpretation.",
  "$defs": {
    "Device": {
      "type": "object",
      "required": [
        "agent_id",
        "recipient",
        "signing_key",
        "protocol",
        "key_package"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "recipient": {
          "type": "string",
          "pattern": "^age1"
        },
        "signing_key": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "protocol": {
          "const": 2
        },
        "key_package": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    },
    "Roster": {
      "type": "object",
      "required": [
        "room_id",
        "version",
        "workspace_id",
        "epoch",
        "previous",
        "members",
        "signature",
        "protocol"
      ],
      "properties": {
        "room_id": {
          "type": "string",
          "pattern": "^rm_mls_[0-9a-f]{32}$"
        },
        "version": {
          "const": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "previous": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})?$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Device"
          }
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "protocol": {
          "const": 2
        },
        "commit": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "welcome": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    },
    "Envelope": {
      "type": "object",
      "required": [
        "room_group",
        "room_id",
        "kind",
        "version",
        "workspace_id",
        "channel_id",
        "sender_id",
        "key",
        "mentions",
        "reply_to",
        "attachment_ids",
        "epoch",
        "roster_hash",
        "ciphertext",
        "signature",
        "capsule",
        "payload_hash"
      ],
      "properties": {
        "room_group": {
          "const": true
        },
        "room_id": {
          "type": "string",
          "pattern": "^rm_mls_[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "message",
            "file"
          ]
        },
        "version": {
          "const": 2
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "channel_id": {
          "type": "string",
          "pattern": "^ch_room_rm_mls_[0-9a-f]{32}_[^_]+$"
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mentions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "roster_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ciphertext": {
          "anyOf": [
            {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "capsule": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "JournalEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "seq",
            "kind",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "roster"
            },
            "payload": {
              "$ref": "#/$defs/Roster"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "seq",
            "kind",
            "payload"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "envelope"
            },
            "payload": {
              "$ref": "#/$defs/Envelope"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/Envelope"
}
